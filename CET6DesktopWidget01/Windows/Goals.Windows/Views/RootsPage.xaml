<UserControl x:Class="Goals.Windows.Views.RootsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="40,30,40,40"><TextBlock Text="词根词缀" Style="{StaticResource PageTitle}"/><TextBlock Text="按构词法记忆 CET-6 词汇" Style="{StaticResource Caption}" FontSize="15" Margin="0,5,0,20"/><TextBox x:Name="Search" Tag="搜索词根、含义或例词，例如：spect、看、inspect" TextChanged="Search_TextChanged" Margin="0,0,0,14"/><ItemsControl x:Name="RootList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Root}" FontFamily="{StaticResource SerifFont}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding Meaning}" Foreground="{StaticResource PlumBrush}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Examples}" FontSize="15"/><TextBlock Text="{Binding Cue}" Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
</UserControl>
