<UserControl x:Class="Goals.Windows.Views.PlanPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,30,40,40">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="计划书" Style="{StaticResource PageTitle}"/><TextBlock Text="手动输入与 AI 生成" Style="{StaticResource Caption}" FontSize="15" Margin="0,5,0,22"/></StackPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="告诉 AI 你的目标背景" Style="{StaticResource SectionTitle}"/>
                <TextBlock Grid.Row="1" Text="例如：目标期限、每天可用时间、薄弱环节和想要的节奏。" Style="{StaticResource Caption}" Margin="0,8,0,12"/>
                <TextBox x:Name="AiBackground" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Tag="例如：30 天后参加考试，每天可用 45 分钟，词汇较弱"/>
                <StackPanel Grid.Row="3" Margin="0,14,0,0"><Button x:Name="AiButton" Content="✦ AI 定计划" Style="{StaticResource PrimaryButton}" Click="AiButton_Click"/><TextBlock x:Name="AiStatus" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel>
            </Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="当前计划表" Style="{StaticResource SectionTitle}"/>
                <TextBox x:Name="PlanTitle" Grid.Row="1" Margin="0,14,0,10" Tag="计划表名称"/>
                <TextBox x:Name="PlanContent" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Tag="在这里编写计划内容，或让左侧 AI 自动生成"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0"><Button Content="保存计划" Style="{StaticResource PrimaryButton}" Click="Save_Click"/><Button Content="查看今日日程" Style="{StaticResource SoftButton}" Margin="10,0,0,0" Click="Today_Click"/><TextBlock x:Name="SaveStatus" VerticalAlignment="Center" Margin="14,0,0,0" Style="{StaticResource Caption}"/></StackPanel>
            </Grid></Border>
        </Grid>
    </Grid>
</UserControl>
