<UserControl x:Class="Goals.Windows.Views.FlashcardsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="True">
    <Grid Margin="40,30,40,34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="闪卡复习" Style="{StaticResource PageTitle}"/><TextBlock Text="正反面快速过" Style="{StaticResource Caption}" FontSize="15" Margin="0,5,0,20"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,10,0,0"><StackPanel Margin="0,0,24,0"><TextBlock x:Name="DueCount" FontFamily="{StaticResource SerifFont}" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="待复习" Style="{StaticResource Caption}"/></StackPanel><StackPanel Margin="0,0,24,0"><TextBlock x:Name="StartedCount" FontFamily="{StaticResource SerifFont}" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="已开始" Style="{StaticResource Caption}"/></StackPanel><StackPanel><TextBlock x:Name="MasteredCount" FontFamily="{StaticResource SerifFont}" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="已掌握" Style="{StaticResource Caption}"/></StackPanel></StackPanel></Grid>
        <Grid Grid.Row="1" Margin="0,0,0,14">
    <Border Background="#80EDEDE9" CornerRadius="8" Padding="4"><StackPanel Orientation="Horizontal"><Button Content="到期优先" Style="{StaticResource SoftButton}" Tag="due" Click="Filter_Click"/><Button Content="全部" Style="{StaticResource SoftButton}" Tag="all" Click="Filter_Click"/><Button Content="收藏" Style="{StaticResource SoftButton}" Tag="favorite" Click="Filter_Click"/><Button Content="高难" Style="{StaticResource SoftButton}" Tag="hard" Click="Filter_Click"/></StackPanel></Border>
        </Grid>
        <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10"><TextBlock x:Name="QueueInfo" FontWeight="SemiBold"/><TextBlock x:Name="ReviewStatus" HorizontalAlignment="Right" Foreground="{StaticResource PlumBrush}"/></Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="30"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760">
                    <TextBlock x:Name="WordText" FontFamily="{StaticResource SerifFont}" FontSize="52" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PronunciationLabel" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,17,0,5"/>
                    <TextBlock x:Name="PronunciationText" FontFamily="{StaticResource SerifFont}" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="RomanizationText" FontSize="15" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                    <StackPanel x:Name="AnswerDetails" Visibility="Collapsed" Margin="0,22,0,0">
                        <Border x:Name="JudgmentBadge" HorizontalAlignment="Center" CornerRadius="7" Padding="11,5" Margin="0,0,0,12"><TextBlock x:Name="JudgmentText" FontWeight="SemiBold"/></Border>
                        <TextBlock x:Name="MeaningText" FontSize="21" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock x:Name="MnemonicText" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock x:Name="ExampleText" FontSize="16" TextAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock x:Name="ExampleTranslationText" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock x:Name="PhrasesText" Foreground="{StaticResource PlumBrush}" FontWeight="SemiBold" TextAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="EmptyText" Text="当前队列没有可复习的词。切换到“全部”或在单词本添加新词。" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="TagText" Grid.Row="1" HorizontalAlignment="Center" Foreground="{StaticResource PlumBrush}"/>
            </Grid></Border>
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid x:Name="AnswerEntryPanel"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="AnswerBox" Tag="输入一个核心中文含义；输入“、”可直接标记为不认识"/><Button x:Name="SubmitButton" Grid.Column="1" Content="➤ 提交判分" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="Submit_Click"/></Grid>
                <Grid x:Name="CorrectionEntryPanel" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CorrectionBox" Tag="看着详情，重新输入其中一个正确中文释义"/><Button x:Name="CorrectionButton" Grid.Column="1" Content="确认复述" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="Correction_Click"/></Grid>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,16,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="‹ 上一个" Style="{StaticResource SoftButton}" Click="Previous_Click"/><Button x:Name="FavoriteButton" Content="☆ 收藏" Style="{StaticResource SoftButton}" Margin="9,0" Click="Favorite_Click"/><Button Content="✂ 斩" Foreground="#A52E2E" Style="{StaticResource SoftButton}" Margin="0,0,9,0" Click="Banish_Click"/><Button x:Name="AdvanceButton" Content="› 跳过" Style="{StaticResource PrimaryButton}" Click="Advance_Click"/></StackPanel><TextBlock x:Name="ShortcutHint" Text="回车：提交答案" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel>
    </Grid>
</UserControl>
