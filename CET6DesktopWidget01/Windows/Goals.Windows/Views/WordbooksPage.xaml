<UserControl x:Class="Goals.Windows.Views.WordbooksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SelectableDictionaryText" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Cursor" Value="IBeam"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="36,18,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="词书" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="完整词库放在这里；单词本只保留你当前要背的词。" Style="{StaticResource Caption}" FontSize="15" Margin="0,4,0,12"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="13">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="每日自动加入单词本" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="每天只抽取尚未加入的词；重启不会重复。当天调高数量会立即补足。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="DailyCountBox" Width="72"/>
                        <TextBlock Text="词/天" VerticalAlignment="Center" Margin="7,0,9,0"/>
                        <Button Content="保存" Style="{StaticResource PrimaryButton}" Padding="14,8" Click="SaveDailyCount_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="13">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="导入本地词书" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="支持 JSON、MDX、MDD、CSS。CSS 和 MDD 会自动匹配配套 MDX；大词书分批保存并支持断点续传。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock x:Name="ImportFileText" Text="尚未选择文件" Style="{StaticResource Caption}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="ImportProgressBar" Height="5" Margin="0,7,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CancelImportButton" Content="暂停" Style="{StaticResource SoftButton}" Padding="12,8" Margin="0,0,7,0" Visibility="Collapsed" Click="CancelImport_Click"/>
                        <Button x:Name="ImportButton" Content="↓ 选择并导入" Style="{StaticResource PrimaryButton}" Padding="15,9" Click="Import_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="2,0,2,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            <ProgressBar x:Name="RefreshingBar" Grid.Row="1" Height="3" Margin="0,7,0,0" IsIndeterminate="True" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="PageText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="PreviousPageButton" Content="‹ 上一页" Style="{StaticResource SoftButton}" Padding="10,5" Margin="0,0,6,0" Click="PreviousPage_Click"/>
                <Button x:Name="NextPageButton" Content="下一页 ›" Style="{StaticResource SoftButton}" Padding="10,5" Click="NextPage_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="3,0,3,10">
                        <StackPanel><TextBlock Text="我的词书" FontWeight="SemiBold" FontSize="17"/><TextBlock x:Name="BookCountText" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel>
                        <Button Content="查看全部" HorizontalAlignment="Right" Style="{StaticResource SoftButton}" Padding="10,6" Click="ShowAllBooks_Click"/>
                    </Grid>
                    <ListBox x:Name="BookList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="BookList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource CleanListItem}"><Setter Property="Margin" Value="0,0,0,8"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="12" Cursor="Hand" Tag="{Binding Mode=OneWay}" PreviewMouseLeftButtonDown="BookCard_PreviewMouseLeftButtonDown">
                                    <Grid>
                                        <StackPanel Margin="0,0,56,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="0,5,0,0" Style="{StaticResource Caption}"><Run Text="{Binding WordCount, StringFormat={}{0:N0}}"/><Run Text=" 词 · 已选 "/><Run Text="{Binding ActiveCount, StringFormat={}{0:N0}}"/></TextBlock>
                                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource PlumBrush}"><Run Text="{Binding StatusLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding UpdatedAt, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm}}"/></TextBlock>
                                        </StackPanel>
                                        <Button Content="删除" Tag="{Binding Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SoftButton}" Padding="9,5" Click="DeleteBookCard_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="AiGeneratorSection" Grid.Row="2" Background="#F4F6F9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="✦ AI 自动生词" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource NavyBrush}"/>
                            <TextBlock Text="选择词库并指定生成数量，由 AI 自动生成词条加入词书。" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="AiLevelCombo" MinHeight="32" Padding="8,4" FontSize="13">
                                    <ComboBoxItem Content="CET-6" IsSelected="True"/>
                                    <ComboBoxItem Content="CET-4"/>
                                </ComboBox>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="AiCountBox" Text="20" Width="44" Padding="4,4" FontSize="13" TextAlignment="Center"/>
                                    <TextBlock Text="词" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Button x:Name="AiGenerateButton" Content="✦ AI 生成" Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="13" Click="AiGenerate_Click"/>
                                <Button x:Name="CancelAiGenerateButton" Content="暂停" Style="{StaticResource SoftButton}" Padding="10,6" FontSize="13" Margin="8,0,0,0" Visibility="Collapsed" Click="CancelAiGenerate_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="AiStatusText" Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            <ProgressBar x:Name="AiProgressBar" Height="3" Margin="0,5,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="DeleteBookButton" Grid.Row="3" Content="删除所选词书" Style="{StaticResource SoftButton}" Margin="0,10,0,0" Padding="12,8" IsEnabled="False" Click="DeleteBook_Click"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="2,0,2,11">
                        <StackPanel>
                            <TextBlock x:Name="EntryTitle" Text="全部词书中的词" FontWeight="SemiBold" FontSize="17"/>
                            <TextBlock Text="点亮右侧五角星即可加入单词本；熄灭后不再进入闪卡，但历史复习记录会保留。" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="SearchBox" Width="270" HorizontalAlignment="Right" Tag="搜索词语、读音或释义" TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                    <Border x:Name="SelectionTranslationPanel" Grid.Row="1" Margin="2,0,2,11" Padding="11" Background="#F2F5FA" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="日语选中翻译" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
                                <TextBlock x:Name="SelectedJapaneseText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SelectedTranslationText" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="×" Style="{StaticResource SoftButton}" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Top" Click="CloseSelectionTranslation_Click" ToolTip="关闭翻译结果"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="EntryList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource CleanListItem}"><Setter Property="Margin" Value="0,0,0,3"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="RowBorder" Style="{StaticResource Card}" Padding="12,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Word.Word}" FontFamily="{StaticResource SerifFont}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Word.Pronunciation}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="15"/>
                                            <TextBlock Text="{Binding Word.Romanization}" Style="{StaticResource Caption}" Margin="0,1,0,0" TextWrapping="Wrap" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Word.PartOfSpeech}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="15"/>
                                            <TextBox Text="{Binding Word.Meaning, Mode=OneWay}" Style="{StaticResource SelectableDictionaryText}" Padding="4,2" FontSize="15" Margin="0,1,0,0" SelectionChanged="JapaneseText_SelectionChanged" ToolTip="选中日文后自动翻译为中文"/>
                                            <TextBlock x:Name="RowTranslation" Foreground="#2D6F55" FontSize="14" TextWrapping="Wrap" Margin="4,3,0,0" Visibility="Collapsed"/>
                                            <TextBox Text="{Binding Word.Example, Mode=OneWay}" Style="{StaticResource SelectableDictionaryText}" Padding="4,1" FontSize="14" Margin="0,3,0,0" SelectionChanged="JapaneseText_SelectionChanged" ToolTip="选中日文后自动翻译为中文"/>
                                            <TextBox Text="{Binding Word.ExampleTranslation, Mode=OneWay}" Style="{StaticResource SelectableDictionaryText}" Foreground="{StaticResource MutedBrush}" FontSize="13" Padding="4,1" Margin="0,1,0,0"/>
                                            <TextBlock Text="{Binding Word.Tag}" Foreground="{StaticResource PlumBrush}" Margin="0,1,0,0" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="译为中文" Padding="10,5" Margin="0,0,10,0" VerticalAlignment="Center" Tag="{Binding Word}" Click="TranslateRow_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SoftButton}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding Word.NeedsJapaneseTranslation}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Grid.Column="1" Content="{Binding StarText, Mode=OneWay}" ToolTip="{Binding StarHint, Mode=OneWay}" Tag="{Binding Mode=OneWay}" Click="StudyStar_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SoftButton}">
                                                            <Setter Property="Foreground" Value="#77756F"/>
                                                            <Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="24"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="#A97918"/><Setter Property="Background" Value="#FFF5D8"/><Setter Property="BorderBrush" Value="#E5C467"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                            <TextBlock Width="42" HorizontalAlignment="Right" TextAlignment="Center" Margin="0,3,0,0" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="加入"/>
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True"><Setter Property="Text" Value="已加入"/><Setter Property="Foreground" Value="#A97918"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
