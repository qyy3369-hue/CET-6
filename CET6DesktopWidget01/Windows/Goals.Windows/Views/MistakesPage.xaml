<UserControl x:Class="Goals.Windows.Views.MistakesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,30,40,40"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="错词收藏" Style="{StaticResource PageTitle}"/><TextBlock Text="收藏词与已斩词分开管理" Style="{StaticResource Caption}" FontSize="15" Margin="0,5,0,20"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><Button Content="收藏错词" Style="{StaticResource SoftButton}" Tag="favorites" Click="Mode_Click"/><Button Content="已斩词" Style="{StaticResource SoftButton}" Tag="banished" Click="Mode_Click" Margin="8,0,0,0"/></StackPanel><TextBox x:Name="Search" Width="330" HorizontalAlignment="Right" Tag="搜索词语、读音或中文释义" TextChanged="Search_TextChanged"/></Grid>
        <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="0,0,0,10"/><ListBox x:Name="List" Grid.Row="1" Background="Transparent" BorderThickness="0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource CleanListItem}"><Setter Property="Margin" Value="0,0,0,9"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Word}" FontFamily="{StaticResource SerifFont}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Pronunciation}" Style="{StaticResource Caption}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Meaning}" FontSize="16"/><TextBlock Text="{Binding Example}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="2" Content="切换收藏 / 恢复学习" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Tag="{Binding}" Click="Action_Click"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
    </Grid>
</UserControl>
