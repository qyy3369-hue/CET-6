<UserControl x:Class="Goals.Windows.Views.TodayPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,30,40,40"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="今日日程" Style="{StaticResource PageTitle}"/><TextBlock x:Name="Subtitle" Style="{StaticResource Caption}" FontSize="15" Margin="0,5,0,20"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="新增今日任务" FontWeight="SemiBold" Margin="2,0,0,6"/><TextBox x:Name="NewTask" Tag="写下一件今天要完成的事"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="时间" FontWeight="SemiBold" Margin="2,0,0,6"/><TextBox x:Name="NewTime" Text="19:30"/></StackPanel><Button Grid.Column="2" Content="＋ 添加到今天" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Click="Add_Click"/></Grid></Border>
        <ListBox x:Name="TaskList" Grid.Row="2" Background="Transparent" BorderThickness="0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource CleanListItem}"><Setter Property="Margin" Value="0,0,0,9"/></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DataTemplate.Resources>
                        <Style x:Key="TaskText" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataTemplate.Resources>
                    <Border Padding="15">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="Background" Value="#F1F3EF"/>
                                        <Setter Property="BorderBrush" Value="#B7C2B8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Time}" Style="{StaticResource TaskText}" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource TaskText}" FontSize="16"/>
                            <Button Grid.Column="2" Margin="8,0" Tag="{Binding}" Click="Toggle_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SoftButton}">
                                        <Setter Property="Content" Value="标记完成"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Content" Value="撤销完成"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="3" Content="删除" Style="{StaticResource SoftButton}" Tag="{Binding}" Click="Delete_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
