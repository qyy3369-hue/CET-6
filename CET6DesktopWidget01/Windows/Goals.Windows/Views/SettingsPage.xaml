<UserControl x:Class="Goals.Windows.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,28,36,42">
            <StackPanel MaxWidth="920" HorizontalAlignment="Stretch">
                <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="管理 AI 服务和保存在这台电脑上的应用数据。" Style="{StaticResource Caption}" FontSize="14" Margin="0,6,0,22"/>

                <Border Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DeepSeek API 密钥" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="用于 AI 计划、补全词条和智能判分。密钥只保存在 Windows 凭据管理器中。" Style="{StaticResource Caption}" Margin="0,7,20,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Top" Background="#ECECE8" CornerRadius="6" Padding="10,5">
                                <TextBlock x:Name="KeyBadge" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="输入新的 API 密钥" FontWeight="SemiBold" Margin="0,20,0,7"/>
                        <PasswordBox x:Name="KeyPassword" PasswordChanged="KeyPassword_PasswordChanged"/>
                        <TextBox x:Name="KeyVisible" Visibility="Collapsed" TextChanged="KeyVisible_TextChanged"/>
                        <CheckBox x:Name="ShowKey" Content="显示本次输入" Checked="ShowKey_Changed" Unchecked="ShowKey_Changed" Margin="0,11,0,15"/>

                        <WrapPanel>
                            <Button Content="保存密钥" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0,0,8,8"/>
                            <Button x:Name="TestButton" Content="测试连接" Style="{StaticResource SoftButton}" Click="Test_Click" Margin="0,0,8,8"/>
                            <Button Content="清除已保存密钥" Style="{StaticResource SoftButton}" Click="Delete_Click" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="软件更新" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="从 GitHub Releases 检查稳定版本，下载完成后自动重启安装。" Style="{StaticResource Caption}" Margin="0,7,20,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Top" Background="#ECECE8" CornerRadius="6" Padding="10,5">
                                <TextBlock x:Name="CurrentVersionText" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                <TextBlock Text="稳定更新通道" FontWeight="SemiBold"/>
                                <TextBlock Text="安装更新只替换程序文件，不会删除目标、词书、单词本和复习记录。" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button x:Name="UpdateButton" Grid.Column="1" Content="检查更新" Style="{StaticResource PrimaryButton}" Click="Update_Click"/>
                        </Grid>

                        <ProgressBar x:Name="UpdateProgress" Height="7" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,17,0,0" Foreground="{StaticResource NavyBrush}" Background="#E5E5E0"/>
                        <TextBlock x:Name="UpdateStatus" Text="更新源：qyy3369-hue/CET-6" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="连接信息" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="以下配置由应用维护，无需手动填写。" Style="{StaticResource Caption}" Margin="0,6,0,16"/>

                        <Border Background="#F4F4F1" CornerRadius="7" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="模型" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ModelText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                        <Border Background="#F4F4F1" CornerRadius="7" Padding="14,12" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="API 接口" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="https://api.deepseek.com/chat/completions" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="本地数据" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="目标与日程保存在轻量数据文件；导入的大词书和对应复习进度保存在独立磁盘词库。两者都仅位于当前 Windows 用户目录，发布文件夹不包含运行数据。" Style="{StaticResource Caption}" Margin="0,7,0,14" TextWrapping="Wrap"/>
                        <TextBlock Text="目标与日程" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <TextBox x:Name="DataPath" IsReadOnly="True"/>
                        <TextBlock Text="导入词库" FontWeight="SemiBold" Margin="0,12,0,7"/>
                        <TextBox x:Name="WordLibraryPath" IsReadOnly="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
