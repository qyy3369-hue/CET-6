<UserControl x:Class="Goals.Windows.Views.AiPracticePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,30,40,40"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}"/><TextBlock x:Name="Subtitle" Style="{StaticResource Caption}" FontSize="15" Margin="0,5,0,20"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Prompt" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/><Button x:Name="GenerateButton" Grid.Column="1" Content="✦ 生成" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="Generate_Click"/></Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="0,0,0,12"/><TextBox x:Name="Output" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Microsoft YaHei UI" FontSize="15"/></Grid></Border>
    </Grid>
</UserControl>
